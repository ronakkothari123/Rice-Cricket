---
import { getCollection } from "astro:content";

import officerPortrait from "@assets/images/shared/officer-portrait.svg";
import ProfileCard from "@components/cards/ProfileCard.astro";
import MediaSplit from "@components/sections/MediaSplit.astro";
import PageHero from "@components/sections/PageHero.astro";
import SectionShell from "@components/sections/SectionShell.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { sortLeadership } from "@utils/content";

const leaders = sortLeadership(await getCollection("leadership"));
---

<BaseLayout title="Leadership" description="Leadership and continuity at Rice Cricket Club">
  <PageHero
    eyebrow="Leadership"
    title="A public leadership layer that makes the club feel real and accountable."
    lede="Version 1 stays leadership-first instead of publishing a full public roster. That keeps the site easier to maintain while still showing continuity, responsibility, and real people behind the club."
    imageSrc={officerPortrait.src}
    imageAlt="Rice Cricket leadership placeholder illustration"
    proof={["Leadership-first v1", "Current officers", "Continuity + accountability"]}
  />

  <SectionShell
    eyebrow="Officers"
    title="Current officers and contact points"
    lede="These profile cards are designed to feel more human than a directory while still remaining easy to update."
  >
    <div class="grid grid--two">
      {leaders.map((leader) => (
        <ProfileCard profile={leader} />
      ))}
    </div>
  </SectionShell>

  <SectionShell eyebrow="Continuity" title="Why this page matters" tone="subtle">
    <MediaSplit
      title="Leadership pages are about trust as much as names."
      copy="Students want to know who to contact. Administrators want to know the club is organized. Future officers need a structure that can be updated quickly at handoff time."
      imageSrc={officerPortrait.src}
      imageAlt="Rice Cricket leadership placeholder illustration"
      points={[
        "Recruitment and communication should have visible ownership.",
        "Leadership updates should be easy once per semester or year.",
        "The page should feel current without requiring a full public roster."
      ]}
    />
  </SectionShell>
</BaseLayout>
