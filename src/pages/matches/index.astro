---
import { getCollection } from "astro:content";

import MatchCard from "@components/cards/MatchCard.astro";
import SectionShell from "@components/sections/SectionShell.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const matches = (await getCollection("matches")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Matches" description="Fixtures and results for Rice Cricket Club">
  <SectionShell
    eyebrow="Matches"
    title="A match archive designed for continuity rather than complexity."
    lede="This page is intentionally lightweight in Chunk 2. It validates the collection shape, archive route, and shared layout patterns."
  >
    <div class="grid grid--two">
      {matches.map((match) => <MatchCard match={match} />)}
    </div>
  </SectionShell>
</BaseLayout>
