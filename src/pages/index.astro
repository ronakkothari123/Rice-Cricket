---
import { getCollection } from "astro:content";

import heroPractice from "@assets/images/shared/hero-practice.svg";
import matchDay from "@assets/images/shared/match-day.svg";
import teamHuddle from "@assets/images/shared/team-huddle.svg";
import FeatureCard from "@components/cards/FeatureCard.astro";
import MatchCard from "@components/cards/MatchCard.astro";
import StatCard from "@components/cards/StatCard.astro";
import StoryCard from "@components/cards/StoryCard.astro";
import CtaBlock from "@components/sections/CtaBlock.astro";
import MediaSplit from "@components/sections/MediaSplit.astro";
import PageHero from "@components/sections/PageHero.astro";
import SectionShell from "@components/sections/SectionShell.astro";
import { siteConfig } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLatestMatches, getLatestStories } from "@utils/content";
import { toBasePath } from "@utils/format";

const stories = getLatestStories(await getCollection("stories"), 2);
const matches = getLatestMatches(await getCollection("matches"), 2);
---

<BaseLayout title="Home" description={siteConfig.siteDescription}>
  <PageHero
    home={true}
    eyebrow={siteConfig.siteEyebrow}
    title="A modern home for cricket, community, and momentum at Rice."
    lede="This shell now reflects the tone established in the planning docs: premium but approachable, editorial rather than generic, and strong enough to support both recruiting and credibility."
    imageSrc={heroPractice.src}
    imageAlt="Rice Cricket practice placeholder illustration"
    actions={siteConfig.primaryCtas.map((action) => ({ ...action, href: toBasePath(action.href) }))}
    proof={siteConfig.homepageStats.map((stat) => `${stat.value} / ${stat.label}`)}
  />

  <SectionShell
    eyebrow="Proof"
    title="Fast signals that Rice Cricket is active, thoughtful, and worth following."
    lede="These stat cards establish a reusable proof language for the homepage, About, and Vision pages."
    tone="subtle"
  >
    <div class="grid grid--three">
      {siteConfig.homepageStats.map((stat) => (
        <StatCard value={stat.value} label={stat.label} note={stat.note} />
      ))}
    </div>
  </SectionShell>

  <SectionShell
    eyebrow="Club Story"
    title="The site should feel welcoming and substantial at the same time."
    lede="The editorial athletics direction matters because the club needs to attract new students while also looking organized and durable to administrators and supporters."
  >
    <MediaSplit
      eyebrow="Culture"
      title="Show belonging and ambition together."
      copy="The eventual site will tell a richer story, but the foundation now supports that story with stronger hierarchy, more intentional layout rhythm, and reusable section patterns."
      imageSrc={teamHuddle.src}
      imageAlt="Rice Cricket team culture placeholder illustration"
      points={[
        "Recruit new students with warmth and clarity.",
        "Document stories, matches, and galleries without backend complexity.",
        "Build a public record strong enough to support long-term facilities conversations."
      ]}
    >
      <div class="page-actions">
        <a class="button button--secondary" href={toBasePath("/about")}>Learn about the club</a>
      </div>
    </MediaSplit>
  </SectionShell>

  <SectionShell
    eyebrow="Pathways"
    title="The homepage should route visitors intentionally."
    lede="These highlight cards correspond to the three jobs the site needs to do well: recruit, prove activity, and build credibility."
    spacing="compact"
  >
    <div class="grid grid--three">
      {siteConfig.homepageHighlights.map((item) => (
        <FeatureCard title={item.title} description={item.description} href={toBasePath(item.href)} />
      ))}
    </div>
  </SectionShell>

  <SectionShell
    eyebrow="Stories"
    title="Recent narrative makes the club feel current."
    lede="The site should not read like a brochure alone. It also needs living proof that the club is active and growing."
  >
    <div class="grid grid--two">
      {stories.map((story) => (
        <StoryCard story={story} />
      ))}
    </div>
  </SectionShell>

  <SectionShell
    eyebrow="Matches"
    title="Competitive proof belongs in the public face."
    lede="Match cards give the homepage a clearer signal that Rice Cricket is not hypothetical or purely social."
    tone="subtle"
  >
    <div class="grid grid--two">
      {matches.map((match) => (
        <MatchCard match={match} />
      ))}
    </div>
  </SectionShell>

  <SectionShell
    eyebrow="Vision"
    title="Facilities ambition should emerge from visible momentum."
    lede="The vision page works best when the homepage has already made the club feel active, welcoming, and worth investing in."
  >
    <MediaSplit
      eyebrow="Long-term case"
      title="Support starts with a credible public record."
      copy="The website is part of how Rice Cricket can show continuity, leadership, growth, and student value before asking for stronger infrastructure."
      imageSrc={matchDay.src}
      imageAlt="Rice Cricket matchday placeholder illustration"
      reversed={true}
      points={[
        "Why facilities matter should be framed practically.",
        "Growth evidence should come before the ask.",
        "The visual language should stay calm, disciplined, and persuasive."
      ]}
    />
  </SectionShell>

  <CtaBlock
    eyebrow="Join"
    title="The foundation is ready for stronger page-level storytelling next."
    copy="Chunk 3 gives the project a cohesive shell, more expressive typography, reusable cards, and clearer route structure. Chunk 4 can focus on deeper content and page composition instead of rebuilding basics."
    actions={[
      { label: "Start with Join", href: toBasePath("/join") },
      { label: "Review the Vision", href: toBasePath("/vision") }
    ]}
  />
</BaseLayout>
