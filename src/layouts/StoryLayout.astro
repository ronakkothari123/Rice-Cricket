---
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate } from "@utils/format";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  author: string;
  category: string;
}

const { title, description, publishDate, author, category } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="story-layout">
    <header class="story-layout__header">
      <p class="section-intro__eyebrow">Stories</p>
      <h1>{title}</h1>
      <p class="story-layout__meta">
        <span>{formatDate(publishDate)}</span>
        <span aria-hidden="true">/</span>
        <span>{author}</span>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </p>
      {description && <p class="story-layout__lede">{description}</p>}
    </header>
    <div class="story-layout__body">
      <slot />
    </div>
  </article>
</BaseLayout>
