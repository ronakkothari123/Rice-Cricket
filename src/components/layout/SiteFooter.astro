---
import { siteConfig } from "@data/site";
import { toBasePath } from "@utils/format";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <p class="section-shell__eyebrow">Rice Cricket Club</p>
      <h2>Static, maintainable, and ready for future growth.</h2>
      <p>{siteConfig.siteDescription}</p>
    </div>

    <div class="site-footer__groups">
      {siteConfig.footerGroups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : toBasePath(link.href)}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</footer>
