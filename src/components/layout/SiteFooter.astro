---
import { siteConfig } from "@data/site";
import { toBasePath } from "@utils/format";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <p class="section-intro__eyebrow">Rice Cricket Club</p>
      <h2>Built to recruit, document momentum, and strengthen the club's long-term case.</h2>
      <p>{siteConfig.siteDescription}</p>
      <div class="site-footer__socials">
        {siteConfig.socialLinks.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="site-footer__groups">
      {siteConfig.footerGroups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : toBasePath(link.href)}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="site-footer__snapshot">
      {siteConfig.homepageStats.map((stat) => (
        <article class="site-footer__snapshot-item">
          <p class="site-footer__snapshot-value">{stat.value}</p>
          <p class="site-footer__snapshot-label">{stat.label}</p>
        </article>
      ))}
    </div>
  </div>
</footer>
