---
import MobileNav from "@components/interactive/MobileNav.astro";
import { siteConfig } from "@data/site";
import { toBasePath } from "@utils/format";

const homeHref = toBasePath("/");
const joinHref = toBasePath("/join");
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={homeHref}>
      <span class="site-brand__eyebrow">Rice University</span>
      <span class="site-brand__name">Rice Cricket Club</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {siteConfig.primaryNav.map((item) => (
          <li>
            <a href={toBasePath(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__utility" href={`mailto:${siteConfig.contactEmail}`}>
        {siteConfig.contactEmail}
      </a>
      <a class="button button--primary" href={joinHref}>
        Join
      </a>
      <MobileNav />
    </div>
  </div>
</header>
