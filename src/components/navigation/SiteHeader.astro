---
import MobileNav from "@components/interactive/MobileNav.astro";
import { siteConfig } from "@data/site";
import { toBasePath } from "@utils/format";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const homeHref = toBasePath("/");
const joinHref = toBasePath("/join");
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={homeHref}>
      <span class="site-brand__eyebrow">Rice University</span>
      <span class="site-brand__name">Rice Cricket Club</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {siteConfig.primaryNav.map((item) => (
          <li>
            <a
              href={toBasePath(item.href)}
              aria-current={currentPath.startsWith(item.href) && item.href !== "/" ? "page" : undefined}
              class:list={[
                "site-nav__link",
                item.href === "/join" && "site-nav__link--join",
                currentPath.startsWith(item.href) && item.href !== "/" && "site-nav__link--active"
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__utility">
        <a href={`mailto:${siteConfig.contactEmail}`}>Email</a>
        <span aria-hidden="true">/</span>
        <a href={siteConfig.socialLinks[2]?.href} target="_blank" rel="noreferrer">
          Instagram
        </a>
      </div>
      <a class="button button--primary button--compact" href={joinHref}>
        Join
      </a>
      <MobileNav currentPath={currentPath} />
    </div>
  </div>
</header>
