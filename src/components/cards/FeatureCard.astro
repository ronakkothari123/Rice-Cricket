---
interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

<article class="feature-card">
  <h3 class="feature-card__title">{title}</h3>
  <p>{description}</p>
  {href && (
    <a class="feature-card__link" href={href}>Explore</a>
  )}
</article>
