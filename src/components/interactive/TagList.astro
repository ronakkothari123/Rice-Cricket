---
import TagChip from "@components/interactive/TagChip.astro";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <TagChip label={tag} />
      </li>
    ))}
  </ul>
)}
