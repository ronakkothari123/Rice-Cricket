---
import SectionIntro from "@components/sections/SectionIntro.astro";

type Action = {
  label: string;
  href: string;
  external?: boolean;
};

interface Props {
  eyebrow?: string;
  title: string;
  copy: string;
  actions: Action[];
}

const { eyebrow, title, copy, actions } = Astro.props;
---

<section class="cta-block">
  <div class="cta-block__inner">
    <SectionIntro eyebrow={eyebrow} title={title} lede={copy} />
    <div class="cta-block__actions">
      {actions.map((action, index) => (
        <a
          class={index === 0 ? "button button--primary" : "button button--secondary"}
          href={action.href}
          target={action.external ? "_blank" : undefined}
          rel={action.external ? "noreferrer" : undefined}
        >
          {action.label}
        </a>
      ))}
    </div>
  </div>
</section>
