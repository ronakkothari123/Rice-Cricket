---
import SectionIntro from "@components/sections/SectionIntro.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  tone?: "default" | "subtle" | "strong";
  spacing?: "default" | "compact" | "hero";
  introAlign?: "left" | "center";
}

const {
  eyebrow,
  title,
  lede,
  tone = "default",
  spacing = "default",
  introAlign = "left"
} = Astro.props;
---

<section class:list={["section-shell", `section-shell--${tone}`, `section-shell--${spacing}`]}>
  {(eyebrow || title || lede) && title && (
    <SectionIntro eyebrow={eyebrow} title={title} lede={lede} align={introAlign} />
  )}
  <div class="section-shell__content">
    <slot />
  </div>
</section>
